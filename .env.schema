# ============================================================================
# .env.schema - project-owned env schema (varlock, env-spec)
# ============================================================================
# Delivered once by the boilerplate, then yours: bun sync never overwrites
# it. The framework half lives in .env.core.schema (generated + synced) and
# is pulled in by the import below. Add the variables YOUR project-under-test
# needs under "Project variables"; keep values out of this file.
#
# Validate:   bunx varlock load --agent      (redacted, agent-safe)
# Explain:    bunx varlock explain <VAR>
# Reference:  https://varlock.dev/reference/item-decorators
#
# @import(./.env.core.schema)
# @generateTsTypes(path=./env.d.ts, processEnv=none, importMetaEnv=none)
# @currentEnv=$TEST_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---

# ----------------------------------------------------------------------------
# Project variables (add below; one decorator line per item, e.g.)
#   # Admin user for the back-office flows
#   # @required=forEnv(staging) @type=email
#   STAGING_ADMIN_EMAIL=
# ----------------------------------------------------------------------------

# Bunkai workspace roles on staging (owner > admin > member > viewer).
# STAGING_USER_* above stays the default role; these drive role-matrix tests.
# @required=forEnv(staging) @type=email
STAGING_OWNER_EMAIL=
# @required=forEnv(staging) @sensitive
STAGING_OWNER_PASSWORD=
# @required=forEnv(staging) @type=email
STAGING_ADMIN_EMAIL=
# @required=forEnv(staging) @sensitive
STAGING_ADMIN_PASSWORD=
# @required=forEnv(staging) @type=email
STAGING_MEMBER_EMAIL=
# @required=forEnv(staging) @sensitive
STAGING_MEMBER_PASSWORD=
# @required=forEnv(staging) @type=email
STAGING_VIEWER_EMAIL=
# @required=forEnv(staging) @sensitive
STAGING_VIEWER_PASSWORD=

# Account that belongs to NO workspace (BK-512 TC31: deleting the only workspace
# lands on onboarding). Optional: only the lone-owner deletion test reads it.
# @type=email
STAGING_LONE_OWNER_EMAIL=
# @sensitive
STAGING_LONE_OWNER_PASSWORD=

# Read-only Postgres connection string for the `workspace_deletions` audit read
# (BK-512 / BK-937). MUST be the `qa_inspector_ro` role (SELECT only, BYPASSRLS):
# the suite only ever runs SELECT through it. Optional: when unset, the audit
# assertions skip with a reason (never fail silently).
# @sensitive
STAGING_DB_RO_URL=
